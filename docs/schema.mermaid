erDiagram
    connections {
        bigint id PK
        text name UK
        text kind
        text host
        text identity
        text secret_store
        bigint created_at
        bigint updated_at
        bigint profile_id FK,UK
    }
    credentials {
        bigint connection_id PK,FK
        text credential
    }
    jira_settings {
        bigint connection_id PK,FK
        bool publish
        bool squash
    }
    profiles {
        bigint id PK
        text name UK
        bigint created_at
        bigint updated_at
    }
    publish_entries {
        bigint slot_id PK,FK
        bigint connection_id PK,FK
        bigint published_at
        text error
    }
    slots {
        bigint id PK
        bigint ticket_id FK
        bigint profile_id FK,UK
        bigint started_at
        bigint stopped_at
        blob uuid UK
    }
    tickets {
        bigint id PK
        bigint profile_id FK
        bigint connection_id FK
        text ticket_key
        text title
        bigint last_worked_at
        bigint synced_at
    }
    connections }o--|| profiles : "profile_id"
    connections }o--o{ slots : "[publish_entries]"
    credentials }o--|| connections : "connection_id"
    jira_settings }o--|| connections : "connection_id"
    publish_entries }o--|| connections : "connection_id"
    publish_entries }o--|| slots : "slot_id"
    slots }o--|| profiles : "profile_id"
    slots }o--|| tickets : "ticket_id"
    tickets }o--|| connections : "connection_id"
    tickets }o--|| profiles : "profile_id"
